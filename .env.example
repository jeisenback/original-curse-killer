# Copy to .env and fill values
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=          # comma-separated Discord user IDs; leave empty to allow everyone
DISCORD_TEST_GUILD_ID=          # guild ID for fast slash-command registration during dev

# Claude CLI
CLAUDE_CLI_PATH=                # full path to claude binary (defaults to "claude" on PATH)
CLAUDE_PROJECT_PATH=            # working directory passed to claude (defaults to cwd)
